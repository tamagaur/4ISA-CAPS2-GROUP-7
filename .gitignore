# Agent context files — session memory, state (local only). CLAUDE.md (project rules) is committed since 2026-10-04.
agent/
.claude/

# Environment
.env
.env.*
!.env.example

# Data — raw inputs are never committed (SSM client data)
data/raw/*
!data/raw/.gitkeep

# The as-delivered client data drop, before it's copied into data/raw/ —
# same SSM-client-data policy as data/raw/*, sitting at repo root instead
SAN SAN Marketing/

# Extract stage output — generated from raw SSM client data, never committed
staging/

# Transform stage output — manifest/review/sign-off, same reasoning as staging/
transform/

# Synthetic demo-data conversion output — regenerable from data/raw/Synthetic
# Data/ via scripts/convert_synthetic_to_staging.py + scripts/generate_synthetic_backfill.py.
# Same "generated output, not committed" reasoning as staging/ above; the
# generator scripts themselves stay tracked in scripts/.
staging_synthetic/

# Per-run slice staging (scripts/load_slices.py) - rewritten every run, never committed.
staging_slices/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Node / Next.js
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Adviser meeting prep — personal speaking notes, not project documentation
analytics/docs/ADVISER_WALKTHROUGH.md

# Acceptance-criteria tracker — team's live status tracking, not project documentation
SSM_ACCEPTANCE_CRITERIA.xlsx

# Jupyter
.ipynb_checkpoints/

# Reference file exports for the team — regenerated from staging/, not committed
REFERENCE_FILES/

# Throwaway analysis / exploration scripts — not project code (29 legacy
# files predate this rule and stay tracked; new ones are ignored)
scratch/

# Live DB backups (scripts/backup_live_db.py output) — full dumps of real
# SSM client data, same never-committed policy as data/raw/ and staging/
# above. The backup TOOL is tracked (scripts/backup_live_db.py); its output
# is not.
backups/

# Manuscript chapter drafts — personal work-in-progress writing, not project
# code. The submitted manuscript (3ISA_7_CP-1_Manuscript.pdf) is now ignored as requested.
# these are the working drafts that churn between versions.
Chapter *.docx

# Specific ignored files requested
3ISA_7_CP-1_Manuscript.pdf
DATABASE_SCHEMA.xlsx


# Production table dumps (2026-09-14 recovery snapshot). Contains real client
# data — customer_dimension has 23,712 customer_name rows and
# salesman_dimension names 33 people. Same class of data as data/raw/ and
# staging/, which are already ignored above; this sat outside those patterns
# and would have been swept in by a `git add -A`.
broken_state_20260914/

# Generated data outputs (e.g. scripts/profile_soh_witness.py's SOH witness
# profile) and raw audit dumps — derived from SSM client files, regenerable,
# same never-committed reasoning as staging/ above.
data/processed/*.parquet
reports/gap_audit_raw.txt

# Dev viewer build inputs, copied from reports/preview/ at build time; the HTML embeds the data
tools/dsd_dev_viewer/data/

# Layout-guard drills (2026-09-30): reformatted COPIES of real client files,
# loaded only into a scratch schema - same never-committed class as data/raw/.
drills/

# Per-product sales and prices: never committed (CLAUDE.md hard rule 9)
local/

backups_run.log
