# Copy to .env and adjust if the backend runs somewhere other than localhost.
VITE_API_URL=http://localhost:8000

# Dev server only: answer the permission endpoints from a mock
# (src/api/mocks/permissionsMock.js) until the backend has them, and show a
# panel to act as Admin or Staff. Ignored by `npm run build`.
VITE_MOCK_PERMISSIONS=false
