# Supabase connection — copy to .env and fill in real values (never commit .env)
SUPABASE_DB_URL=postgresql://postgres.dsdxemtmbbmdtccwxzyk:<database-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_DIRECT_URL=postgresql://postgres:<database-password>@db.dsdxemtmbbmdtccwxzyk.supabase.co:5432/postgres
SUPABASE_KEY=your-supabase-anon-or-service-key-here

# Supabase Storage (backend/avatar.py, POST /users/me/avatar) — the project's
# base URL and its SERVICE ROLE key specifically, never the anon key: writing
# another user's folder in the `avatars` bucket needs to bypass Storage RLS.
SUPABASE_URL=https://dsdxemtmbbmdtccwxzyk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# backend/ JWT auth (see backend/deps.py, Story #89) — JWT_SECRET_KEY must
# be a long random string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`).
# Generate your own; never put a real key or password in this file.
JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256

# Story #91: session expiry — how long a login stays valid before the
# frontend forces a re-login. Hours, may be fractional (e.g. 0.5 = 30 min).
JWT_EXPIRY_HOURS=8

# CORS — comma-separated origins allowed to call this API. Default (if unset)
# covers the Vite dev server only (localhost:5173 / 127.0.0.1:5173). Add your
# deployed frontend's origin here before deploying anywhere shared.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Account emails — invites and password-reset links (backend/mailer.py).
# Gmail: turn on 2-Step Verification, create an app password at
# myaccount.google.com/apppasswords and put its 16 letters in SMTP_PASSWORD.
# Leave these unset and the admin gets a copyable link instead of an email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-address@gmail.com
SMTP_PASSWORD=your-16-letter-app-password
SMTP_FROM="SSM Dashboard <your-sending-address@gmail.com>"

# Where the links in those emails point: the frontend's address.
FRONTEND_URL=http://localhost:5173

# production hides the API's /docs, /redoc and /openapi.json pages.
APP_ENV=development
