# Supabase connection — copy to .env and fill in real values (never commit .env)
SUPABASE_DB_URL=postgresql://user:password@host:port/dbname
SUPABASE_KEY=your-supabase-anon-or-service-key-here

# backend/ API auth (see backend/deps.py) — any long random string works
# locally; generate a real one before deploying anywhere shared.
BACKEND_API_KEY=change-me-to-a-long-random-string
